# Force LF line endings for shell scripts and git hooks (required for cross-platform compatibility)
.husky/* text eol=lf
*.sh text eol=lf

# Force LF line endings for dotenv files and templates (a CR leaks into env values, see #8498)
*.env text eol=lf
.env text eol=lf
.env.* text eol=lf

# Force LF line endings for TypeScript sources (checksum tests hash raw file bytes)
*.ts text eol=lf
*.tsx text eol=lf
